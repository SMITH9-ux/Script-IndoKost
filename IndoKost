local function resolveKnitRemote(serviceName, remoteType, remoteName, timeout)
    timeout = timeout or 3
    local remote = nil
    pcall(function()
        local svc = ReplicatedStorage
            :WaitForChild("NKSystem", timeout)
            :WaitForChild("Packages", timeout)
            :WaitForChild("Knit", timeout)
            :WaitForChild("Services", timeout)
            :WaitForChild(serviceName, timeout)
            :WaitForChild(remoteType, timeout)
        
        remote = svc:WaitForChild(remoteName, timeout)
    end)
    return remote
end

local function getBeliRF()
    if not Remotes.BeliBibitRF then
        Remotes.BeliBibitRF = resolveKnitRemote("TanamService", "RF", "BeliBibit", 2)
    end
    Remotes.IsFarmReady = (Remotes.BeliBibitRF ~= nil and Remotes.TanamRF ~= nil)
    return Remotes.BeliBibitRF
end

local function getTanamRF()
    if not Remotes.TanamRF then
        Remotes.TanamRF = resolveKnitRemote("TanamService", "RF", "Tanam", 2)
    end
    Remotes.IsFarmReady = (Remotes.BeliBibitRF ~= nil and Remotes.TanamRF ~= nil)
    return Remotes.TanamRF
end

local function getCleanEvent()
    if not Remotes.CleanEvent then
        Remotes.CleanEvent = resolveKnitRemote("KosanStateService", "RE", "CleanProgress", 2)
    end
    Remotes.IsCleanReady = (Remotes.CleanEvent ~= nil)
    return Remotes.CleanEvent
end

