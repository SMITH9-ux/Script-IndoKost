local function getActivePlots()
    local plots = {}
    for _, lahan in ipairs(LAHAN_LIST) do
        if lahan.Selected then
            for _, pt in ipairs(lahan.Coordinates) do
                table.insert(plots, pt)
            end
        end
    end
    for _, customPt in ipairs(Config.CustomPlots) do
        table.insert(plots, customPt)
    end
    return plots
end

local function executeFarmCycle()
    local beliRF = getBeliRF()
    local tanamRF = getTanamRF()

    if Config.AutoBuy and beliRF then
        local buyOk = pcall(function()
            return beliRF:InvokeServer(Config.CropName, Config.BuyCount)
        end)
        if buyOk then
            State.TotalBought = State.TotalBought + Config.BuyCount
        end
    end

    task_wait(Config.FarmDelay)

    local currentPlots = getActivePlots()
    for _, plotPos in ipairs(currentPlots) do
        if not State.FarmActive then break end

        if tanamRF then
            local plantOk = pcall(function()
                return tanamRF:InvokeServer(Config.CropName, plotPos)
            end)
            if plantOk then
                State.TotalPlanted = State.TotalPlanted + 1
            end
        end

        task_wait(Config.FarmDelay)
    end
end

-- Cari semua kotoran di Workspace
local function findAllDirt()
    local dirts = {}
    local char = LocalPlayer.Character
    local rootPos = (char and char:FindFirstChild("HumanoidRootPart")) and char.HumanoidRootPart.Position or Vector3.new(0, 0, 0)

    local allObjects = Workspace:GetDescendants()
    for i = 1, #allObjects do
        local obj = allObjects[i]
        if obj:IsA("BasePart") and obj.Name:lower() == Config.TargetName:lower() then
            if obj.Material == Config.TargetMaterial then
                local dist = (obj.Position - rootPos).Magnitude
                if Config.InfiniteRange or dist <= Config.CleanRadius then
                    table.insert(dirts, { Object = obj, Distance = dist })
                end
            end
        end
    end

    table.sort(dirts, function(a, b) return a.Distance < b.Distance end)
    return dirts
end

-- Bersihkan kotoran DARI JARAK JAUH
local function executeCleanDirt(dirtEntry)
    if not dirtEntry or not dirtEntry.Object then return end
    local dirtTarget = dirtEntry.Object
    local cleanEv = getCleanEvent()

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local oldCFrame = root and root.CFrame

    -- 1. BYPASS PROXIMITY PROMPT DISTANCE (Hapus limit 10-studs)
    local prompt = dirtTarget:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and Config.BypassPrompt then
        pcall(function()
            prompt.MaxActivationDistance = 9999999
            prompt.RequiresLineOfSight = false
            prompt.HoldDuration = 0
            prompt.Enabled = true
        end)
    end

    -- 2. GHOST TOUCH (Jika server mengecek jarak karakter ke kotoran)
    if Config.GhostTeleport and root and dirtTarget:IsA("BasePart") then
        pcall(function()
            root.CFrame = CFrame.new(dirtTarget.Position + Vector3.new(0, 2, 0))
        end)
    end

    -- 3. TRIGGER KNIT REMOTE SERVICE
    if cleanEv then
        if typeof(firesignal) == "function" then
            pcall(function()
                firesignal(cleanEv.OnClientEvent, Config.KosanID, "Kotor", true)
            end)
        end
        pcall(function()
            cleanEv:FireServer(Config.KosanID, "Kotor", true)
        end)
    end

    -- 4. TRIGGER PROXIMITY PROMPT
    if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then
        pcall(function()
            fireproximityprompt(prompt, 0)
        end)
    end

    -- 5. KEMBALIKAN POSISI KARAKTER INSTAN
    if Config.GhostTeleport and root and oldCFrame then
        task_wait(0.03)
        pcall(function()
            root.CFrame = oldCFrame
        end)
    end

    State.TotalCleaned = State.TotalCleaned + 1
end

