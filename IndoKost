    knob.BorderSizePixel = 0
    knob.Parent = switchBtn
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local isEnabled = defaultState

    local function updateVisuals()
        local targetKnobPos = isEnabled and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        local targetColor = isEnabled and THEME.AccentFarm or Color3.fromRGB(38, 43, 60)
