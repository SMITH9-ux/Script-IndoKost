        State.CleanThread = task_spawn(function()
            while State.CleanActive do
                local dirts = findAllDirt()
                State.NearbyDirtCount = #dirts

                if #dirts > 0 then
                    for _, dirtEntry in ipairs(dirts) do
                        if not State.CleanActive then break end
                        executeCleanDirt(dirtEntry)
                        task_wait(Config.CleanLoop)
                    end
                else
                    task_wait(0.5)
                end
            end
        end)
    else
        CleanMainBtn.Text = "▶ AKTIFKAN AUTO CLEAN"
        CleanMainBtn.BackgroundColor3 = THEME.AccentClean
        CleanPill.Text = "🧹 CLEAN: OFF"
        CleanPill.TextColor3 = THEME.TextMuted
        showToast("⏹ Auto Clean Dihentikan", THEME.TextMuted)

        if State.CleanThread then
            task_cancel(State.CleanThread)
            State.CleanThread = nil
        end
    end
end

