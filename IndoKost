local function updateCleanState(isActive)
    State.CleanActive = isActive
    if State.CleanActive then
        CleanMainBtn.Text = "⏹ HENTIKAN AUTO CLEAN"
        CleanMainBtn.BackgroundColor3 = THEME.Danger
        CleanPill.Text = "🧹 CLEAN: ON"
