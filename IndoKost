-- Safe Remote Resolver
local function resolveRemote(remoteName: string)
    local success, remote = pcall(function()
        return ReplicatedStorage
            :WaitForChild("NKSystem", 5)
            :WaitForChild("Packages", 5)
            :WaitForChild("Knit", 5)
            :WaitForChild("Services", 5)
            :WaitForChild("TanamService", 5)
            :WaitForChild("RF", 5)
            :WaitForChild(remoteName, 5)
    end)
    return if success then remote else nil
end

local beliBibitRF = resolveRemote("BeliBibit")
local tanamRF = resolveRemote("Tanam")

if not beliBibitRF or not tanamRF then
    warn("[AutoFarm]: Gagal mendeteksi RemoteFunction Knit Service.")
    return
end

