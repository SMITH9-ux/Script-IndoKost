    isMaximized = not isMaximized
    local targetSize = isMaximized and MAXIMIZED_SIZE or NORMAL_SIZE
    TweenService:Create(mainFrame, TWEEN_FAST, { Size = targetSize }):Play()
end)

local function stopFarmingLoop()
    isRunning = false
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
end

btnClose.MouseButton1Click:Connect(function()
    stopFarmingLoop()
    screenGui:Destroy()
end)

-- Farming Loop Implementation
local function executeFarmingCycle()
    local buySuccess, buyErr = pcall(function()
        return beliBibitRF:InvokeServer(CONFIG.CROP_NAME, CONFIG.BUY_COUNT)
    end)

    if not buySuccess then
        warn("[AutoFarm Error]: Beli gagal:", buyErr)
    end

    task.wait(CONFIG.INTER_ACTION_DELAY)

    for index, plotPos in ipairs(PLOT_COORDINATES) do
        if not isRunning then break end

        local plantSuccess, plantErr = pcall(function()
            return tanamRF:InvokeServer(CONFIG.CROP_NAME, plotPos)
        end)

        if not plantSuccess then
            warn(string.format("[AutoFarm Error]: Plot #%d gagal: %s", index, tostring(plantErr)))
        end

        task.wait(CONFIG.INTER_ACTION_DELAY)
    end
end

local function startFarmingLoop()
    farmThread = task.spawn(function()
        while isRunning do
            executeFarmingCycle()
            task.wait(CONFIG.CYCLE_COOLDOWN)
        end
    end)
end

-- Toggle Button Logic
toggleButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    
    local targetColor = if isRunning then Color3.fromRGB(16, 185, 129) else Color3.fromRGB(225, 29, 72)
    local targetText = if isRunning then "ACTIVE (RUNNING)" else "START AUTOMATION"

    TweenService:Create(toggleButton, TWEEN_FAST, { BackgroundColor3 = targetColor }):Play()
    toggleButton.Text = targetText

    if isRunning then
        startFarmingLoop()
    else
        stopFarmingLoop()
    end
end)
