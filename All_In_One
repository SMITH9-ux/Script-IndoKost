--[[
    AUTO BUANG SAMPAH v3 — MULTI TONG
    Author : Cobalt (refactored)

    Alur :
      ZonaPlastikSammpah
         └── SpawanPlastikSampah        (item sampah)
      Temmpatsampah  (parent)
         ├── TemmmpatSampah
         ├── TemmmpatSampah1
         └── TemmmpatSampah2            (target buang)

    Fitur : Multi tong, mode pemilihan, GUI minimize + exit, guard anti-loop.
--]]

-- ============================================================
-- SERVICES
-- ============================================================
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local CoreGui           = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- KONFIGURASI
-- ============================================================
local CONFIG = {
    -- Item sampah
    SampahName       = "SpawanPlastikSampah",
    ZonaSampahParent = "ZonaPlastikSammpah",

    -- Parent tong sampah
    TongSampahParent = "Temmpatsampah",

    -- Daftar tong (urutan prioritas)
    TongSampahNames  = {
        "TemmmpatSampah",
        "TemmmpatSampah1",
        "TemmmpatSampah2",
    },

    -- "roundrobin" | "nearest" | "first"
    Mode             = "roundrobin",

    Interval         = 0.25,
    AutoStart        = true,
    FallbackRecursive = true,   -- cari ke seluruh workspace kalau parent tidak ketemu
    MoveMethod       = "parent",-- "parent" = ganti Parent | "cframe" = pindah posisi
}

-- ============================================================
-- EVENT PlayPickupAnim
-- ============================================================
local PlayPickupAnim
do
    local ok, res = pcall(function()
        return ReplicatedStorage
            .NKSystem.Packages.Knit.Services
            .KosanStateService.RE.PlayPickupAnim
    end)
    if ok then PlayPickupAnim = res
    else warn("[AutoSampah] Event PlayPickupAnim tidak ditemukan!") end
end

local function FirePickupAnim(state)
    if not PlayPickupAnim then return end
    if type(firesignal) == "function" then
        firesignal(PlayPickupAnim.OnClientEvent, state)
    else
        pcall(function() PlayPickupAnim:Fire(state) end)
    end
end

-- ============================================================
-- HELPER: Cari object dari parent zone
-- ============================================================
local function FindFromParent(parentName, childName)
    local parent = workspace:FindFirstChild(parentName, true)
    if parent then
        local child = parent:FindFirstChild(childName, true)
        if child then return child, parent end
    end
    if CONFIG.FallbackRecursive then
        return workspace:FindFirstChild(childName, true), parent
    end
    return nil, parent
end

-- Posisi aman untuk Model / Folder / BasePart
local function GetPosition(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    local pp = inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart")
    if pp and pp:IsA("BasePart") then return pp.Position end
    return nil
end

-- ============================================================
-- HELPER: Ambil semua tong yang tersedia
-- ============================================================
local function GetAvailableBins()
    local list = {}
    for i, name in ipairs(CONFIG.TongSampahNames) do
        local obj = FindFromParent(CONFIG.TongSampahParent, name)
        if obj then
            table.insert(list, { index = i, name = name, obj = obj })
        end
    end
    return list
end

-- ============================================================
-- PEMILIHAN TONG
-- ============================================================
local rrIndex = 0

local function PickBin(bins)
    if #bins == 0 then return nil end

    if CONFIG.Mode == "first" then
        return bins[1]
    end

    if CONFIG.Mode == "nearest" then
        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return bins[1] end

        local best, bestDist = bins[1], math.huge
        for _, b in ipairs(bins) do
            local pos = GetPosition(b.obj)
            if pos then
                local d = (pos - hrp.Position).Magnitude
                if d < bestDist then best, bestDist = b, d end
            end
        end
        return best
    end

    -- roundrobin
    rrIndex = (rrIndex % #bins) + 1
    return bins[rrIndex]
end

-- ============================================================
-- CORE
-- ============================================================
local Running    = CONFIG.AutoStart
local LastBinTxt = "-"

-- Guard: cegah item dianggap "sampah" jika sudah ada di dalam tong
local function IsInsideAnyBin(item, bins)
    for _, b in ipairs(bins) do
        if item:IsDescendantOf(b.obj) then return true end
    end
    return false
end

local function AmbilDanBuangSampah()
    -- 1) Ambil sampah
    local sampah = FindFromParent(CONFIG.ZonaSampahParent, CONFIG.SampahName)
    if not sampah then return end

    -- 2) Cek tong tersedia
    local bins = GetAvailableBins()
    if #bins == 0 then return end

    -- 3) Guard anti-loop
    if IsInsideAnyBin(sampah, bins) then return end

    -- 4) Trigger anim pickup
    FirePickupAnim(false)

    -- 5) Pilih tong & buang
    local target = PickBin(bins)
    if not target then return end

    pcall(function()
        if CONFIG.MoveMethod == "cframe" then
            local srcPos  = GetPosition(sampah)
            local destPos = GetPosition(target.obj)
            if sampah:IsA("BasePart") and destPos then
                sampah.CFrame = CFrame.new(destPos)
            elseif srcPos and destPos then
                -- model: geser via PivotTo
                sampah:PivotTo(CFrame.new(destPos))
            end
            -- tetap reparent agar sistem game mendeteksi
            sampah.Parent = target.obj
        else
            sampah.Parent = target.obj
        end
    end)

    LastBinTxt = target.name
end

-- ============================================================
-- LOOP UTAMA
-- ============================================================
task.spawn(function()
    while task.wait(CONFIG.Interval) do
        if Running then
            pcall(AmbilDanBuangSampah)
        end
    end
end)

