local function switchTab(tab)
    if tab == "Plant" then
        PlantPage.Visible = true
        CleanPage.Visible = false

        TweenService:Create(TabPlantBtn, TWEEN_SMOOTH, {
            BackgroundColor3 = Color3.fromRGB(38, 42, 62),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()

        TweenService:Create(TabCleanBtn, TWEEN_SMOOTH, {
            BackgroundColor3 = Color3.fromRGB(20, 22, 32),
            TextColor3 = Color3.fromRGB(130, 135, 155)
        }):Play()
    elseif tab == "Clean" then
        PlantPage.Visible = false
        CleanPage.Visible = true

        TweenService:Create(TabCleanBtn, TWEEN_SMOOTH, {
            BackgroundColor3 = Color3.fromRGB(38, 42, 62),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()

        TweenService:Create(TabPlantBtn, TWEEN_SMOOTH, {
            BackgroundColor3 = Color3.fromRGB(20, 22, 32),
            TextColor3 = Color3.fromRGB(130, 135, 155)
        }):Play()
    end
end

