--[[
    ====================================================================
    AUTO CLEANER (CONFIGURABLE PARAMETERS VIA UI)
    Platform: Luau / Client-Side Script
    ====================================================================
]]

-- SERVICES
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- CONFIGURATION & STATE
local Config = {
    TargetName = "kotoran",
    TargetMaterial = Enum.Material.Plastic,
    DefaultKosanID = "8833771934_19",
    DefaultRadius = 10000,
    DefaultLoop = 0.4,
    MinLoopInterval = 0.10 -- Batas aman untuk mencegah crash/freeze
}

local State = {
    IsEnabled = false,
    CurrentKosanID = Config.DefaultKosanID,
    KosanOwner = "",
    RoomNumber = "",
    Radius = Config.DefaultRadius,
    LoopInterval = Config.DefaultLoop
}

-- PARSER: Memisahkan ID Kosan ("8833771934_19" -> Owner ID & Room Number)
local function parseKosanID(idString)
    local parts = string.split(tostring(idString), "_")
    return parts[1] or "", parts[2] or ""
end

State.KosanOwner, State.RoomNumber = parseKosanID(State.CurrentKosanID)

-- RESOLVE NETWORK ENDPOINT
local Event = nil
pcall(function()
    Event = ReplicatedStorage:WaitForChild("NKSystem", 5)
        :WaitForChild("Packages", 5)
        :WaitForChild("Knit", 5)
        :WaitForChild("Services", 5)
        :WaitForChild("KosanStateService", 5)
        :WaitForChild("RE", 5)
        :WaitForChild("CleanProgress", 5)
end)

-- LOGIC: Trigger Event
local function fireCleanSignal(targetId)
    if not Event then return end

    if typeof(firesignal) == "function" then
        firesignal(Event.OnClientEvent, targetId, "Kotor", true)
    else
        pcall(function()
            Event:FireServer(targetId, "Kotor", true)
        end)
    end
end

-- LOGIC: Deteksi Objek
local function findNearestDirt()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = character.HumanoidRootPart.Position

    local nearestTarget = nil
    local shortestDistance = State.Radius

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower() == Config.TargetName:lower() then
            if obj.Material == Config.TargetMaterial then
                local distance = (obj.Position - rootPos).Magnitude
                if distance <= shortestDistance then
                    shortestDistance = distance
                    nearestTarget = obj
                end
            end
        end
    end

    return nearestTarget
end

-- MAIN WORKER LOOP
task.spawn(function()
    while true do
        if State.IsEnabled then
            local target = findNearestDirt()
            if target then
                fireCleanSignal(State.CurrentKosanID)
                
                local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then
                    fireproximityprompt(prompt)
                end
            end
        end
        -- Delay dinamis mengikuti input UI
        task.wait(State.LoopInterval)
    end
end)

