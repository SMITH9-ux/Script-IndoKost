-- ====================================================================
-- EVENT HANDLERS
-- ====================================================================

table.insert(Connections, IdInput.FocusLost:Connect(function()
    State.CurrentKosanID = IdInput.Text
    local o, r = parseKosanID(IdInput.Text)
    State.KosanOwner, State.RoomNumber = o, r
    InfoLabel.Text = string.format("Owner: %s | Room: %s", o, r)
end))

table.insert(Connections, RadiusInput.FocusLost:Connect(function()
    local val = tonumber(RadiusInput.Text)
    State.Radius = (val and val > 0) and val or Config.DefaultRadius
    RadiusInput.Text = tostring(State.Radius)
    StatusLabel.Text = string.format("Radius: %s studs | Loop: %ss", State.Radius, State.LoopInterval)
end))

table.insert(Connections, LoopInput.FocusLost:Connect(function()
    local val = tonumber(LoopInput.Text)
    State.LoopInterval = (val and val >= Config.MinLoopInterval) and val or Config.DefaultLoop
    LoopInput.Text = tostring(State.LoopInterval)
    StatusLabel.Text = string.format("Radius: %s studs | Loop: %ss", State.Radius, State.LoopInterval)
end))

-- Toggle Script Run/Pause
table.insert(Connections, ToggleBtn.MouseButton1Click:Connect(function()
    State.IsEnabled = not State.IsEnabled
    local col = State.IsEnabled and Color3.fromRGB(45, 170, 75) or Color3.fromRGB(200, 50, 50)
    TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = col}):Play()
    ToggleBtn.Text = State.IsEnabled and "AUTO CLEAN: ON" or "AUTO CLEAN: OFF"
end))

-- Minimize / Expand Animation
table.insert(Connections, MiniBtn.MouseButton1Click:Connect(function()
    State.IsMinimized = not State.IsMinimized
    local targetHeight = State.IsMinimized and Config.MiniHeight or Config.FullHeight
    
    Content.Visible = not State.IsMinimized
    MiniBtn.Text = State.IsMinimized and "+" or "−"

    TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 260, 0, targetHeight)
    }):Play()
end))

-- Exit & Cleanup
table.insert(Connections, ExitBtn.MouseButton1Click:Connect(function()
    State.IsRunning = false
    State.IsEnabled = false
    for _, conn in ipairs(Connections) do
        if conn and conn.Disconnect then conn:Disconnect() end
    end
    table.clear(Connections)
    ScreenGui:Destroy()
end))
