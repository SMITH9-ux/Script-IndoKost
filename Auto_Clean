local function parseKosanID(idString)
    local parts = string.split(tostring(idString), "_")
    return parts[1] or "-", parts[2] or "-"
end
State.KosanOwner, State.RoomNumber = parseKosanID(State.CurrentKosanID)

-- RESOLVE NETWORK ENDPOINT
local CleanEvent = nil
pcall(function()
    CleanEvent = ReplicatedStorage:WaitForChild("NKSystem", 3)
        :WaitForChild("Packages", 3)
        :WaitForChild("Knit", 3)
        :WaitForChild("Services", 3)
        :WaitForChild("KosanStateService", 3)
        :WaitForChild("RE", 3)
        :WaitForChild("CleanProgress", 3)
end)

local function fireCleanSignal(targetId)
    if not CleanEvent then return end
    if typeof(firesignal) == "function" then
        firesignal(CleanEvent.OnClientEvent, targetId, "Kotor", true)
    else
        pcall(function() CleanEvent:FireServer(targetId, "Kotor", true) end)
    end
end

local function findNearestDirt()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = char.HumanoidRootPart.Position

    local nearest, minDist = nil, State.Radius
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower() == Config.TargetName:lower() then
            if obj.Material == Config.TargetMaterial then
                local dist = (obj.Position - rootPos).Magnitude
                if dist <= minDist then
                    minDist = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

-- BACKGROUND WORKER LOOP (Tetap berjalan meski UI diminimalkan)
task.spawn(function()
    while State.IsRunning do
        if State.IsEnabled then
            local target = findNearestDirt()
            if target then
                fireCleanSignal(State.CurrentKosanID)
                local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then
                    fireproximityprompt(prompt)
                end
            end
        end
        task.wait(State.LoopInterval)
    end
end)

