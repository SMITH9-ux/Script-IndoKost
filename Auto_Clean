-- ====================================================================
-- INPUT BINDINGS & SANITIZATION
-- ====================================================================

-- Handler Kosan ID
IdInput.FocusLost:Connect(function()
    State.CurrentKosanID = IdInput.Text
    local owner, room = parseKosanID(IdInput.Text)
    State.KosanOwner = owner
    State.RoomNumber = room
    InfoLabel.Text = string.format("Owner: %s | Room: %s", owner, room)
end)

-- Handler Radius (Validasi angka > 0)
RadiusInput.FocusLost:Connect(function()
    local parsed = tonumber(RadiusInput.Text)
    if parsed and parsed > 0 then
        State.Radius = parsed
    else
        State.Radius = Config.DefaultRadius
        RadiusInput.Text = tostring(Config.DefaultRadius)
    end
    StatusParamLabel.Text = string.format("Radius: %s studs | Loop: %ss", State.Radius, State.LoopInterval)
end)

-- Handler Loop Delay (Validasi angka >= MinLoopInterval)
LoopInput.FocusLost:Connect(function()
    local parsed = tonumber(LoopInput.Text)
    if parsed and parsed >= Config.MinLoopInterval then
        State.LoopInterval = parsed
    else
        State.LoopInterval = Config.DefaultLoop
        LoopInput.Text = tostring(Config.DefaultLoop)
    end
    StatusParamLabel.Text = string.format("Radius: %s studs | Loop: %ss", State.Radius, State.LoopInterval)
end)

-- Handler Toggle Button
ToggleBtn.MouseButton1Click:Connect(function()
    State.IsEnabled = not State.IsEnabled
    
    local targetColor = State.IsEnabled and Color3.fromRGB(46, 180, 80) or Color3.fromRGB(200, 50, 50)
    local targetText = State.IsEnabled and "AUTO CLEAN: ON" or "AUTO CLEAN: OFF"
    
    TweenService:Create(ToggleBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundColor3 = targetColor
    }):Play()
    
    ToggleBtn.Text = targetText
end)
