local function createInputField(name, placeholder, defaultValue, posY)
    local box = Instance.new("TextBox")
    box.Name = name
    box.Size = UDim2.new(0.88, 0, 0, 28)
    box.Position = UDim2.new(0.06, 0, 0, posY)
    box.BackgroundColor3 = Color3.fromRGB(34, 34, 40)
    box.TextColor3 = Color3.fromRGB(225, 225, 225)
    box.Text = tostring(defaultValue)
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(110, 110, 120)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.Parent = Content
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    return box
end

